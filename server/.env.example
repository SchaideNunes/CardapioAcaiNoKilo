# Backend — copie para server/.env e preencha. Nunca versione o server/.env.

PORT=3001
# Em produção use "production": exige JWT_SECRET forte e não libera o Vite local no CORS
NODE_ENV=development

# MongoDB local ou Atlas (mongodb+srv://usuario:senha@cluster/...)
MONGODB_URI=mongodb://127.0.0.1:27017/cardapio-acai
DB_NAME=cardapio-acai
# Coleção do cardápio (a migration.js popula "preco")
COLLECTION_NAME=preco

# Segredo de assinatura dos tokens do admin: mínimo 32 caracteres, recomendado 64 aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
# Vazio fora de produção = libera o Vite local (http://localhost:5173 e :4173).
CORS_ORIGINS=

# Nº de proxies reversos à frente do servidor (ex.: 1 no Render/Railway/Nginx). Vazio = nenhum.
TRUST_PROXY=

# Usados apenas por `node server/create-admin.js` para criar/redefinir o administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend (Vite) — copie para .env.local e ajuste. Só variáveis com prefixo VITE_ chegam ao navegador:
# nunca coloque segredos aqui.

# URL do backend. Padrão: http://localhost:3001
VITE_API_URL=http://localhost:3001

# "false" desativa o login de demonstração offline (admin/admin). Use false em produção.
VITE_DEMO_MODE=true
